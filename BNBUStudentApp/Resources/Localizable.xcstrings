    "密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码"
          }
        }
      }
    },
    "密码仅用于登录请求，不写入本地持久化状态。短期登录令牌保存在本机 Keychain；工作台缓存和未提交草稿使用完整文件保护并排除云备份。退出登录会清理当前账号凭据、缓存和草稿。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is used only for sign-in and is not stored locally. Short-lived tokens are kept in Keychain. Workspace caches and unsent drafts use complete file protection and are excluded from cloud backup. Signing out clears the current account credentials, cache, and drafts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码仅用于登录请求，不写入本地持久化状态。短期登录令牌保存在本机 Keychain；工作台缓存和未提交草稿使用完整文件保护并排除云备份。退出登录会清理当前账号凭据、缓存和草稿。"
          }
        }
      }
    },
